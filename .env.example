# Telegram API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Pre-authenticated Session (Provide either TELEGRAM_SESSION or TELEGRAM_SESSION_PATH)
# Option A: String Session (generated via 'python3 login.py')
TELEGRAM_SESSION=
# Option B: Direct path to an existing Telethon SQLite session file (e.g. anon.session or /path/to/my_account.session)
# TELEGRAM_SESSION_PATH=

# Environment configuration
# Set to 'true' to connect to Telegram Test Server (DC 2) with test numbers (e.g. 999662XXXX, OTP 22222)
# Set to 'false' for production Telegram network
TELEGRAM_TEST_MODE=true

# Optional: Set to 'true' to bypass the test/prod environment mismatch shield
# TELEGRAM_IGNORE_ENV_MISMATCH=false

# Optional: Default target bot username for interactions (e.g., @my_bot or my_bot)
DEFAULT_TARGET_BOT=
