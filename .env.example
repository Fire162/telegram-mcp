# Telegram API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Pre-authenticated String Session (generated via 'pnpm run login')
TELEGRAM_SESSION=

# Environment configuration
# Set to 'true' to connect to Telegram Test Server (DC 2) with test numbers (e.g. 999662XXXX, OTP 22222)
# Set to 'false' for production Telegram network
TELEGRAM_TEST_MODE=true

# Optional: Default target bot username for interactions (e.g., @my_bot or my_bot)
DEFAULT_TARGET_BOT=
