{
  "name": "telegram-bot-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for automated Telegram bot interaction and verification",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "telegram-bot-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "login": "tsx src/auth-helper.ts",
    "login:py": "python3 login.py"
  },
  "keywords": [
    "mcp",
    "telegram",
    "bot-testing",
    "agentic-ai",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "dotenv": "^16.4.7",
    "telegram": "^2.26.21",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
